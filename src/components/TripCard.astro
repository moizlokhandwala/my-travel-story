---
import type { CollectionEntry } from 'astro:content';
import Cover from './Cover.astro';
import { STATUS_BADGE, tripPlace, withBase } from '../config';

interface Props {
  trip: CollectionEntry<'trips'>;
}

const { trip } = Astro.props;
const { title, summary, status, accent } = trip.data;
const place = tripPlace(trip.data);
---

<a class="card" href={withBase(`trips/${trip.id}/`)} style={`--accent: ${accent}`}>
  <Cover trip={trip} width={600} />
  <div class="card-body">
    {place && <p class="eyebrow">{place}</p>}
    <h3>{title}</h3>
    <p>{summary}</p>
    {status !== 'published' && <p style="margin-top: 0.75rem"><span class="badge">{STATUS_BADGE[status]}</span></p>}
  </div>
</a>
